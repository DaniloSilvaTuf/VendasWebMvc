@model VendasWebMvc.Models.Vendedor

@{
    ViewData["Title"] = "Deletar";
}

<h2>@ViewData["Title"]</h2>
<h3>Tem certeza que deseja deletar?</h3>

<div>
    <h4>Vendedor</h4>
    <hr />
    <dl class="list-group-horizontal">
        <dt>
            @Html.DisplayNameFor(model => model.Nome)
        </dt>
        <dd>
            @Html.DisplayFor(Model => Model.Nome)
        </dd>
        <dt>
            @Html.DisplayNameFor(Model => Model.Email)
        </dt>
        <dd>
            @Html.DisplayFor(Model => Model.Email)
        </dd>
        <dt>
            @Html.DisplayNameFor(Model => Model.DataNascimento)
        </dt>
        <dd>
            @Html.DisplayFor(Model => Model.DataNascimento)
        </dd>
        <dt>
            @Html.DisplayNameFor(Model => Model.SalarioBase)
        </dt>
        <dd>
            @Html.DisplayFor(Model => Model.SalarioBase)
        </dd>
    </dl>

    <form asp-action="Deletar">
        <input type="hidden" asp-for="Id"/>
        <input type="submit" value="Deletar" class="brn btn-danger"/>
        <a asp-action="Index">Voltar a lista</a>
    </form>
</div>